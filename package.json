{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "reference-data:check": "node scripts/load-reference-data.mjs --check",
    "reference-data:write": "node scripts/load-reference-data.mjs --write",
    "reference-data:local": "node scripts/load-reference-data.mjs --local",
    "reference-data:linked": "node scripts/load-reference-data.mjs --linked",
    "lint:sql": "sqlfluff lint supabase/migrations supabase/seeds",
    "lint:all": "npm run lint && npm run lint:sql",
    "fixture-data:check": "node scripts/load-fixture-data.mjs --check",
    "fixture-data:write": "node scripts/load-fixture-data.mjs --write",
    "demo-data:check": "node scripts/load-fixture-data.mjs --dataset=demo --check",
    "demo-data:write": "node scripts/load-fixture-data.mjs --dataset=demo --write",
    "seed:reference": "supabase db reset",
    "seed:demo": "supabase db reset && docker exec -i supabase_db_jobvana psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/seeds/10_demo_data.sql && docker exec -i supabase_db_jobvana psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/seeds/99_reset_taxonomy_sequences.sql",
    "seed:bulk": "supabase db reset && docker exec -i supabase_db_jobvana psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/seed.sql && docker exec -i supabase_db_jobvana psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/seeds/99_reset_taxonomy_sequences.sql",
    "dev:local": "node scripts/dev-local.mjs",
    "supabase:start:local": "node scripts/start-local-supabase.mjs"
  },
  "dependencies": {
    "@supabase/storage-js": "^2.89.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.142.11",
    "@tanstack/react-router-devtools": "^1.142.11",
    "dayjs": "^1.11.19",
    "lodash": "^4.17.21",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.18",
    "use-debounce": "^10.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tanstack/router-plugin": "^1.142.11",
    "@types/lodash": "^4.17.21",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "supabase": "2.118.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^8.0.0"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
